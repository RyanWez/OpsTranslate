# ---- Required for a live run -------------------------------------------
BOT_TOKEN=
PROVIDER_BASE_URL=        # e.g. https://api.example.com/v1  (no trailing /v1 duplication)
PROVIDER_API_KEY=
PROVIDER_MODEL=           # e.g. translate-pro

# ---- Run mode -------------------------------------------------------------
MODE=polling             # polling (local testing) | webhook (production)

# ---- Phase 0 group gate (GP-member-only access) ------------------------------
GROUP_CHAT_ID=           # e.g. -1004417127000 (bot must be admin in the group)
GROUP_CACHE_TTL_S=21600  # membership verdict cache (seconds)

# ---- Testing shortcuts ----------------------------------------------------
TEST_ALLOW_ALL=false     # true = skip the allowlist gate (local testing only)

# ---- Telegram alerting (Path A) -------------------------------------------
ALERT_BOT_TOKEN=         # separate bot token for admin alerts (recommended)
ADMIN_CHAT_ID=           # chat id that receives alerts; unset = log to stdout

# ---- Webhook mode (production) --------------------------------------------
WEBHOOK_SECRET=          # X-Telegram-Bot-Api-Secret-Token header value
WEBHOOK_PATH_SECRET=     # secret path segment: /webhook/<this>
PUBLIC_URL=              # e.g. https://opstranslate.koyeb.app (for setWebhook)

# ---- Storage (optional - the bot degrades gracefully without them) ---------
DATABASE_URL=            # Neon pooled connection string
REDIS_URL=               # Upstash Redis URL

# ---- Seeding ---------------------------------------------------------------
ALLOWED_USER_IDS=        # comma-separated Telegram user ids (staff role)
ADMIN_USER_IDS=          # comma-separated Telegram user ids (admin role)

# ---- Product rules ---------------------------------------------------------
MAX_INPUT_CHARS=250
POLICY_VERSION=1

# ---- Provider tuning -------------------------------------------------------
PROVIDER_TIMEOUT_S=8
PROVIDER_MAX_CONCURRENCY=8
# Optional: backup providers as JSON (replaces the single PROVIDER_* set).
# PROVIDERS_JSON='[{"name":"backup","base_url":"https://...","api_key":"...","model":"...","priority":2}]'

# ---- Spending guard --------------------------------------------------------
DAILY_SPEND_CAP_USD=5.0
PROVIDER_COST_PER_MSG_USD=0.0004
