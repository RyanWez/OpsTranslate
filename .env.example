# ---- Required for a live run -------------------------------------------
BOT_TOKEN=
DATABASE_URL=            # Neon pooled connection string (REQUIRED: providers live in DB, managed via /admin)
REDIS_URL=               # Upstash Redis URL

# ---- Run mode -------------------------------------------------------------
MODE=polling             # polling (local testing) | webhook (production)

# ---- Phase 0 group gate (GP-member-only access) ------------------------------
GROUP_CHAT_ID=           # e.g. -1004417127000 (bot must be admin in the group)
GROUP_CACHE_TTL_S=21600  # membership verdict cache (seconds)
GROUP_DENY_TTL_S=300     # deny verdict cache: fresh joins get in fast
# Link on the "Access" button shown when a non-member presses /start.
ACCESS_CONTACT_URL=https://t.me/ImYourSuperman

# ---- Testing shortcuts ----------------------------------------------------
TEST_ALLOW_ALL=false     # true = skip the allowlist gate (local testing only)

# ---- Telegram alerting (Path A) -------------------------------------------
ALERT_BOT_TOKEN=         # separate bot token for admin alerts (recommended)
ADMIN_CHAT_ID=           # chat id that receives alerts; unset = log to stdout

# ---- Webhook mode (production) --------------------------------------------
WEBHOOK_SECRET=          # X-Telegram-Bot-Api-Secret-Token header value
WEBHOOK_PATH_SECRET=     # secret path segment: /webhook/<this>
PUBLIC_URL=              # e.g. https://opstranslate.fly.dev (for setWebhook)

# ---- Egress proxy (optional) ----------------------------------------------
# aiohttp (aiogram's session) ignores proxy env vars by default, so on hosts
# where all outbound traffic must go through a proxy, set one of these or the
# Telegram API calls fail with SSL errors. Unset = direct connection.
HTTPS_PROXY=             # e.g. http://user:pass@proxy:3128
ALL_PROXY=               # e.g. socks5://proxy:1080

# ---- Storage (optional - the bot degrades gracefully without them) ---------
# (DATABASE_URL/REDIS_URL are under "Required" above - providers live in DB)

# ---- Seeding ---------------------------------------------------------------
ALLOWED_USER_IDS=        # comma-separated Telegram user ids (staff role)
ADMIN_USER_IDS=          # comma-separated Telegram user ids (admin role)

# ---- Product rules ---------------------------------------------------------
MAX_INPUT_CHARS=500
POLICY_VERSION=1
AUTO_TOGGLE=true         # Myanmar -> English, English -> Myanmar; false = use stored target

# ---- Handler budget --------------------------------------------------------
# Per-update wall-clock budget (seconds). Spec SHOULD 16 says 12s, but the live
# provider's first reasoning-heavy call takes ~11s, so 12s would turn most
# translations into ERROR_GENERIC; 60s is the kept deviation. PROVIDER_TIMEOUT_S
# still fires first on each per-provider call.
HANDLER_BUDGET_S=60

# ---- Provider tuning (credentials are DB-only, managed via /admin) --------
PROVIDER_TIMEOUT_S=8
PROVIDER_MAX_CONCURRENCY=8
PROVIDER_MAX_OUTPUT_TOKENS=1024  # output budget for a full 500-char translation

# ---- Spending guard --------------------------------------------------------
DAILY_SPEND_CAP_USD=5.0
PROVIDER_COST_PER_MSG_USD=0.0004
IGNORE_DAILY_CAPS=true       # true = bypass daily soft cap and daily budget cap
WITHHOLD_ON_LEAK=false        # false = auto-sanitize forbidden words and deliver; true = withhold

# ---- Rate Limiting (Burst & Anti-Spam Protection) --------------------------
RATE_LIMIT_ENABLED=true       # true = enable sliding-window burst protection; false = disable
RATE_LIMIT_COUNT=2            # Maximum messages allowed per rolling window
RATE_LIMIT_WINDOW_S=30        # Rolling window length in seconds
RATE_LIMIT_BYPASS_ADMINS=true # true = admins are exempt from rate limiting

# ---- Security & Encryption at Rest -----------------------------------------
# REQUIRED for the admin panel. No default: if unset (or the legacy "admin123"),
# the panel is fail-closed and NO login will succeed.
ADMIN_PASSWORD=              # strong password to access /admin dashboard
# REQUIRED to store provider API keys. No default: if unset, saving a provider
# API key is rejected and existing keys cannot be decrypted. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTE: rotating this value makes previously stored provider keys undecryptable
# - re-enter them in /admin Providers after changing it.
ENCRYPTION_KEY=              # strong 32+ byte secret for Fernet key encryption
# Behind a trusted proxy, name the header carrying the real client IP so the
# login brute-force lockout buckets by real IP (Fly.io sets "Fly-Client-IP",
# which the client cannot forge). Leave empty to bucket by the socket peer.
# Never point this at a header the client can set freely (e.g. X-Forwarded-For).
TRUSTED_CLIENT_IP_HEADER=    # e.g. Fly-Client-IP on Fly.io

# ---- Database Backups ------------------------------------------------------
# Run automated backup: python scripts/backup_db.py --backup
# List backups:         python scripts/backup_db.py --list
# Prune old backups:    python scripts/backup_db.py --prune --keep-days 7


